{
  "name": "pi-subagents",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Persistent research subagents for pi: delegate investigations to child pi sessions that you can re-engage, inspect, and enter.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=60000 test/*.test.ts",
    "test:pi": "node --import tsx test/integration.ts",
    "test:fleet": "node --import tsx test/fleet-smoke.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^26.0.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.0"
  }
}
