{
  "name": "pi-subagents",
  "version": "0.3.1",
  "license": "MIT",
  "description": "Persistent research subagents for pi: delegate investigations to child pi sessions that you can re-engage, inspect, and enter.",
  "type": "module",
  "keywords": [
    "pi-package",
    "subagents",
    "research"
  ],
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=60000 test/*.test.ts",
    "test:pi": "node --import tsx test/integration.ts",
    "test:fleet": "node --import tsx test/fleet-smoke.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "^26.0.0",
    "tsx": "^4.20.0",
    "typebox": "1.4.7",
    "typescript": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slim-bean/pi-subagents.git"
  },
  "homepage": "https://github.com/slim-bean/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/slim-bean/pi-subagents/issues"
  }
}
